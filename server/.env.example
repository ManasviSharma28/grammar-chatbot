# Copy to server/.env and fill in. Never commit server/.env.

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Tried in order when the primary model is over quota or unavailable for this key.
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite

# MongoDB connection string. Leave empty in development to use a throwaway
# in-memory MongoDB (data is lost when the server stops). Required in production.
MONGODB_URI=

# Random secret, at least 32 chars. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

PORT=4000
# Browser origins allowed to call the API (Expo web dev server). Native apps are unaffected.
CORS_ORIGINS=http://localhost:8081
CHAT_RATE_LIMIT_PER_MINUTE=20
