# Copy to .env and fill in. EXPO_PUBLIC_* values are bundled into the app and
# are visible to anyone with the app — never put secrets here. AI keys live in
# server/.env only.

# Backend base URL (Phase 3+). Leave unset to run the UI in preview mode.
# iOS simulator: http://localhost:4000
# Android emulator: http://10.0.2.2:4000
# Physical device: http://<your-computer-LAN-IP>:4000
EXPO_PUBLIC_API_URL=
